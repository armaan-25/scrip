# Ramp Developer API credentials (sandbox or production).
# Leave RAMP_CLIENT_ID / RAMP_CLIENT_SECRET unset to run against the local
# MockRampGateway instead of a real Ramp connection.
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=
RAMP_API_BASE_URL=https://demo-api.ramp.com

# Separate static API key for the ai-usage/unified broadcast (AI Usage
# Tracking) - different auth model from the OAuth client-credentials pair
# above. Generated from your own Ramp account (Settings -> Integrations),
# not the Developer Console app registration.
RAMP_AI_USAGE_API_KEY=

# The real Ramp Fund ID backing the "research" budget in scrip.yaml.
RAMP_RESEARCH_FUND_ID=

# Command name or absolute path for the real `ramp-cli` binary (e.g. "ramp"
# if it's on PATH, from https://agents.ramp.com/install.sh). When set,
# reserveCardPurchase mints a REAL Ramp Agent Card by shelling out to
# `ramp funds creds` - the only path to Ramp's actual Agent Cards product,
# since it's built on an API that's "not accessible to external clients"
# by direct REST (see docs/ramp-api-notes.md's "Card issuance" section).
# Requires `ramp auth login` already done interactively in this environment
# - this process never runs that itself. Takes priority over
# RAMP_CARDHOLDER_USER_ID below if both are set. Also requires the
# reservation's budget to have a ramp_fund_id in scrip.yaml that is itself
# enrolled for agent card payments (check with
# `ramp funds get-agent-card-funds` - not every fund is enrolled, confirmed
# live 2026-08-08).
RAMP_CLI_BIN=

# Real Ramp user ID that reserveCardPurchase's minted cards are issued
# under, when RAMP_CLI_BIN above is NOT set. Requires the "Scrip" app to
# also have cards:read_vault and limits:write scopes, AND the Ramp account
# to be a "vault API access holder" (a business-level PCI-qualification
# entitlement Ramp grants separately from app scopes - see
# docs/ramp-api-notes.md's "Card issuance" section). Note: this path mints
# a real Vault API card, not a real Ramp Agent Card - a different Ramp
# product. Leave both RAMP_CLI_BIN and RAMP_CARDHOLDER_USER_ID unset to use
# MockCardIssuer instead of minting real cards.
RAMP_CARDHOLDER_USER_ID=

ANTHROPIC_API_KEY=
